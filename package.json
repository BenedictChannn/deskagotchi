{
  "name": "deskagotchi",
  "version": "0.1.0",
  "description": "Windows-first desktop virtual pet companion built with Electron, React, TypeScript, and Vite.",
  "main": "out/main/index.js",
  "author": "Deskagotchi",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "generate:icon": "node scripts/generate-app-icon.mjs",
    "generate:items": "node scripts/generate-lcd-item-icons.mjs",
    "generate:pets": "node scripts/generate-placeholder-pets.mjs",
    "validate:pets": "vitest run src/main/packageRegistry.test.ts",
    "qa:desktop:launch": "node scripts/qa/desktop-qa.mjs launch",
    "qa:desktop:drag": "node scripts/qa/desktop-qa.mjs drag",
    "qa:desktop:drag:os": "node scripts/qa/desktop-qa.mjs drag --os-only",
    "qa:desktop:overlay": "node scripts/qa/desktop-qa.mjs overlay",
    "qa:desktop:play": "node scripts/qa/desktop-qa.mjs play",
    "qa:desktop:lifecycle": "node scripts/qa/desktop-qa.mjs lifecycle",
    "qa:renderer": "node scripts/qa/desktop-qa.mjs renderer",
    "qa:assets:pets": "node scripts/qa/assets-qa.mjs pets",
    "qa:assets:items": "node scripts/qa/assets-qa.mjs items",
    "qa": "node scripts/qa/run-all.mjs",
    "lint": "eslint . --max-warnings=0",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "precommit": "npm run lint && npm run typecheck",
    "prepare": "husky",
    "package:win": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.0",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "playwright": "^1.59.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^7.3.2",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "app.deskagotchi.desktop",
    "productName": "Deskagotchi",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
